---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  sideBarActiveItemID="home"
>
  <main class="max-w-3xl space-y-12">

    <!-- Introduction -->
    <section class="space-y-5">
      <p class="text-sm font-semibold tracking-widest uppercase text-primary">
        Economics Researcher
      </p>

      <h1 class="text-4xl md:text-5xl font-bold text-base-content">
        Ye Yuan <span class="text-2xl font-normal opacity-60">元野</span>
      </h1>

      <p class="text-lg leading-relaxed">
        Welcome to my website! I am an economics researcher
        working in health economics, family economics, and
        applied microeconomics.
      </p>

      <p class="leading-relaxed text-base-content/80">
        My research focuses on healthcare systems, marriage
        matching, and gender norms. I use empirical methods
        and data from administrative records, household surveys,
        and biomarkers to study economic behaviour and
        policy outcomes.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/research" class="btn btn-primary">
          My Research
        </a>
        <a href="mailto:ye.yuan@citystgeorges.ac.uk" class="btn btn-outline">
          Contact Me
        </a>
      </div>
    </section>

    <div class="divider"></div>

    <!-- Research Interests -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold">Research Interests</h2>

      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline p-4">Applied Microeconomics</span>
        <span class="badge badge-outline p-4">Health Economics</span>
        <span class="badge badge-outline p-4">Family Economics</span>
        <span class="badge badge-outline p-4">Gender Economics</span>
      </div>
    </section>

    <!-- Selected Research -->
    <section class="space-y-6">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold">Selected Research</h2>
        <a href="/research" class="link link-primary text-sm">
          View all →
        </a>
      </div>

      <div class="border-l-4 border-primary pl-5 space-y-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">
          Job Market Paper
        </p>
        <h3 class="text-lg font-semibold">
          Congestion Spillovers in Multi-Stage Public Services:
          Evidence from England's Emergency Care System
        </h3>
        <p class="text-sm text-base-content/70">
          With Damian Clarke
        </p>
      </div>

      <div class="border-l-4 border-base-300 pl-5 space-y-2">
        <p class="text-xs font-semibold uppercase tracking-wider opacity-60">
          Publication · 2025
        </p>
        <h3 class="text-lg font-semibold">
          A Quantitative Review of Matching Papers in Economics:
          Evolution, Diversity, and Gender
        </h3>
        <p class="text-sm italic text-base-content/70">
          Oxford Research Encyclopedia of Economics and Finance
        </p>
      </div>
    </section>

  </main>
</BaseLayout>
