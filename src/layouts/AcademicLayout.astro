---
// A clean, standalone layout. It does not render Astrofy's sidebar, header, or cards.
import '../styles/academic.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ye Yuan | Economics Researcher',
  description = 'The academic homepage of Ye Yuan. Research in health economics, family economics, and applied microeconomics.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
