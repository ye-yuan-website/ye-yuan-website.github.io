---
import AcademicLayout from '../layouts/AcademicLayout.astro';

// Existing PDF links from the previous Google Sites website.
// Replace these with files in /public/papers and /public/cv.pdf whenever ready.
const cvUrl = 'https://cdn.jsdelivr.net/gh/YYuan4031357/CV@main/CV%20-%20Ye%20Yuan.pdf';
const jmpUrl = 'https://cdn.jsdelivr.net/gh/YYuan4031357/JobMarketPaper/Job%20Market%20Paper%20-%20Ye%20Yuan.pdf';
const stigmaUrl = 'https://cdn.jsdelivr.net/gh/YYuan4031357/StigmaProject/Yuan.%20Y%20%282026%29%20-%20Stigma%2C%20Concealment%2C%20and%20Marriage%20Matching.pdf';
const reviewUrl = 'https://doi.org/10.1093/acrefore/9780190625979.013.986';
const reviewPdfUrl = 'https://robinsoncortes.github.io/website_files/matching_review.pdf';
---

<AcademicLayout>
  <div class="academic-site">
    <header class="profile-header" id="top">
      <h1>Ye Yuan <span class="chinese-name" lang="zh-Hans">元野</span></h1>
      <p class="role">Economics Researcher</p>
      <nav class="profile-links" aria-label="Profile links">
        <a href="mailto:yy429@exeter.ac.uk">Email</a>
        <span aria-hidden="true">·</span>
        <a href={cvUrl} target="_blank" rel="noopener noreferrer">CV</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/YYuan4031357" target="_blank" rel="noopener noreferrer">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://bsky.app/profile/ye-yuan.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>
      </nav>
    </header>

    <main>
      <section class="intro" aria-label="About me">
        <p>
          I am an economics researcher whose interests lie in health economics,
          family economics, and applied microeconomics. I carried out my doctoral
          research at the University of Exeter.
        </p>
        <p>
          I study healthcare systems, marriage matching, and gender norms, using
          quasi-experimental methods and evidence from administrative records,
          household surveys, and biomarkers.
        </p>
      </section>

      <section id="research" class="section-block" aria-labelledby="research-heading">
        <h2 id="research-heading">Research</h2>

        <h3>Job Market Paper</h3>
        <article class="paper">
          <p class="paper-title">
            Congestion Spillovers in Multi-Stage Public Services:
            Evidence from England's Emergency Care System
          </p>
          <p class="paper-meta">
            with <a href="https://www.damianclarke.net/" target="_blank" rel="noopener noreferrer">Damian Clarke</a>
          </p>
          <p class="paper-links">
            <a href={jmpUrl} target="_blank" rel="noopener noreferrer">PDF (earlier draft)</a>
          </p>
          <p class="abstract">
            We examine how congestion in one stage of a public service system
            affects outcomes elsewhere. Using a £700 million hospital discharge
            intervention in England in 2022–2023, the paper studies how improved
            patient flow reduces ambulance handover delays and increases
            ambulance availability. The findings suggest that easing hospital
            bottlenecks can improve emergency response and survival among
            out-of-hospital cardiac arrest patients.
          </p>
        </article>

        <h3>Publications</h3>
        <article class="paper">
          <p class="paper-title">
            A Quantitative Review of Matching Papers in Economics:
            Evolution, Diversity, and Gender
          </p>
          <p class="paper-meta">
            with Climent Quintana-Domeque and Alejandro Robinson-Cortés
          </p>
          <p class="paper-meta">
            <em>Oxford Research Encyclopedia of Economics and Finance</em>, 2025
          </p>
          <p class="paper-links">
            <a href={reviewUrl} target="_blank" rel="noopener noreferrer">Publication</a>
            <span aria-hidden="true">·</span>
            <a href={reviewPdfUrl} target="_blank" rel="noopener noreferrer">PDF</a>
          </p>
          <p class="abstract">
            We trace the evolution of matching research in economics using
            bibliographic text data. The review documents growth in the field,
            its intellectual diversity, and changes in collaboration patterns,
            including persistent differences in gender representation.
          </p>
        </article>

        <h3>Work in Progress</h3>
        <ul class="work-list">
          <li>
            <span class="work-title">Stigma, Concealment, and Marriage Matching: Biomarker Evidence from Korea</span>
            <span class="work-link">— <a href={stigmaUrl} target="_blank" rel="noopener noreferrer">PDF</a></span>
          </li>
          <li>Labour Regulation and Sex Selection in China</li>
          <li>Education for Identity: Bidimensional Marriage Matching and Ethnic Preferences in China</li>
        </ul>
      </section>

      <section class="section-block small-section" aria-labelledby="advisors-heading">
        <h2 id="advisors-heading">PhD Advisors</h2>
        <p>
          Climent Quintana-Domeque,
          <a href="https://www.damianclarke.net/" target="_blank" rel="noopener noreferrer">Damian Clarke</a>,
          and <a href="https://www.robinson-cortes.com/" target="_blank" rel="noopener noreferrer">Alejandro Robinson-Cortés</a>.
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Ye Yuan</span>
      <span aria-hidden="true">·</span>
      <a href="mailto:yy429@exeter.ac.uk">yy429@exeter.ac.uk</a>
    </footer>
  </div>
</AcademicLayout>
